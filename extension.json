{
	"name": "UTDRTweaks",
	"version": "1.0.0",
	"author": [
		"[https://kocka.tech/ Luka Simić]"
	],
	"url": "https://undertale.wiki/",
	"descriptionmsg": "utdr-desc",
	"license-name": "MIT",
	"type": "other",
	"MessagesDirs": {
		"UTDRTweaks": [
			"i18n"
		]
	},
	"requires": {
		"MediaWiki": ">= 1.44.0"
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\UTDRTweaks\\": "includes/"
	},
	"SpecialPages": {
		"AnalyticsOptOut": {
			"class": "MediaWiki\\Extension\\UTDRTweaks\\Special\\AnalyticsOptOut"
		}
	},
	"ResourceModules": {
		"ext.utdrtweaks.optout.scripts": {
			"scripts": [
				"ext.utdrtweaks.optout.js"
			],
			"messages": [
				"utdr-optout-error",
				"utdr-optout-success"
			]
		}
	},
	"ResourceFileModulePaths": {
		"localBasePath": "resources",
		"remoteExtPath": "UTDRTweaks/resources"
	},
	"Hooks": {
		"AuthChangeFormFields": "main",
		"BeforeCreateEchoEvent": "main",
		"ContentModelCanBeUsedOn": "main",
		"EditFilterMergedContent": "main",
		"SkinAddFooterLinks": "main",
		"HtmlCacheUpdaterAppendUrls": "main",
		"ImageBeforeProduceHTML": "main",
		"MediaWikiServices": "main",
		"SelfLinkBegin": "main",
		"SidebarBeforeOutput": "main",
		"TemplateStylesStylesheetSanitizer": "main",
		"TitleIsAlwaysKnown": "main",
		"UploadForm:getInitialPageText": "main",
		"WantedPages::getQueryInfo": "main",
		"GetLocalURL": "main"
	},
	"HookHandlers": {
		"main": {
			"class": "MediaWiki\\Extension\\UTDRTweaks\\Hooks"
		}
	},
	"config_prefix": "wgUTDR",
	"config": {
		"BlockedEmailRegex": {
			"description": "Regular expression determining which emails are blocked from the wiki",
			"value": null,
			"public": false
		},
		"SupportedLanguages": {
			"description": "List of languages to limit support to",
			"value": null,
			"public": true
		}
	},
	"manifest_version": 2
}
